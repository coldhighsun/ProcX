<ui:FluentWindow x:Class="ProcX.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:conv="clr-namespace:ProcX.App.Converters"
                 xmlns:vm="clr-namespace:ProcX.App.ViewModels"
                 xmlns:views="clr-namespace:ProcX.App.Views"
                 xmlns:domain="clr-namespace:ProcX.Domain.Processes;assembly=ProcX.Domain"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
                 Title="{Binding Title}"
                 Width="1200"
                 Height="720"
                 MinWidth="640"
                 MinHeight="400"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterScreen">
    <ui:FluentWindow.Resources>
        <conv:ByteSizeConverter x:Key="ByteSize" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:DepthToIndentConverter x:Key="DepthIndent" />

        <!-- Expand/collapse chevron of a tree row; reserves its space on leaves so names stay aligned. -->
        <Style x:Key="TreeExpander" TargetType="Button">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ui:SymbolIcon x:Name="Glyph" FontSize="12" Symbol="ChevronDown24" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding NodeKind}" Value="{x:Static vm:TreeNodeKind.Collapsed}">
                                <Setter TargetName="Glyph" Property="Symbol" Value="ChevronRight24" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding NodeKind}" Value="{x:Static vm:TreeNodeKind.Leaf}">
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
                <DataTrigger Binding="{Binding NodeKind}" Value="{x:Static vm:TreeNodeKind.Collapsed}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding NodeKind}" Value="{x:Static vm:TreeNodeKind.Expanded}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RightAligned" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="DetailsRow" Height="280" MinHeight="0" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" />

        <!-- Toolbar -->
        <DockPanel Grid.Row="1" Margin="12,4,12,8" LastChildFill="False">
            <ui:TextBox DockPanel.Dock="Left"
                        Width="320"
                        PlaceholderText="Search by name, PID, user or path"
                        Text="{Binding Processes.SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                        ClearButtonEnabled="True"
                        Icon="{ui:SymbolIcon Search24}" />

            <ui:ToggleSwitch DockPanel.Dock="Left"
                             Margin="16,0,0,0"
                             VerticalAlignment="Center"
                             Content="Tree view"
                             ToolTip="Show processes as a parent/child tree. Sorting by a column returns to the flat list."
                             IsChecked="{Binding Processes.IsTreeView}" />

            <ui:ToggleSwitch DockPanel.Dock="Left"
                             Margin="16,0,0,0"
                             VerticalAlignment="Center"
                             Content="Details"
                             ToolTip="Show general information, threads, modules and handles of the selected process"
                             IsChecked="{Binding IsDetailsVisible}" />

            <ui:Button DockPanel.Dock="Right"
                       Margin="8,0,0,0"
                       Content="End task"
                       Appearance="Danger"
                       Icon="{ui:SymbolIcon Dismiss24}"
                       ToolTip="End the selected process (Del)"
                       Command="{Binding EndTaskCommand}" />
            <ui:Button DockPanel.Dock="Right"
                       Content="Run as administrator"
                       Icon="{ui:SymbolIcon ShieldKeyhole24}"
                       ToolTip="Restart ProcX with administrator rights to see and manage all processes"
                       Command="{Binding RestartAsAdministratorCommand}"
                       Visibility="{Binding CanElevate, Converter={StaticResource BoolToVisibility}}" />
        </DockPanel>

        <!-- Process list -->
        <DataGrid Grid.Row="2"
                  x:Name="ProcessGrid"
                  Margin="12,0,12,0"
                  ItemsSource="{Binding Processes.View}"
                  SelectedItem="{Binding Processes.SelectedRow}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="None"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel">
            <DataGrid.InputBindings>
                <KeyBinding Key="Delete" Command="{Binding EndTaskCommand}" />
                <KeyBinding Key="Delete" Modifiers="Shift" Command="{Binding EndProcessTreeCommand}" />
            </DataGrid.InputBindings>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="End task" InputGestureText="Del" Command="{Binding EndTaskCommand}" />
                    <MenuItem Header="End process tree" InputGestureText="Shift+Del" Command="{Binding EndProcessTreeCommand}" />
                    <Separator />
                    <MenuItem Header="Set priority">
                        <MenuItem Header="Realtime" Command="{Binding SetPriorityCommand}" CommandParameter="{x:Static domain:ProcessPriority.Realtime}" />
                        <MenuItem Header="High" Command="{Binding SetPriorityCommand}" CommandParameter="{x:Static domain:ProcessPriority.High}" />
                        <MenuItem Header="Above normal" Command="{Binding SetPriorityCommand}" CommandParameter="{x:Static domain:ProcessPriority.AboveNormal}" />
                        <MenuItem Header="Normal" Command="{Binding SetPriorityCommand}" CommandParameter="{x:Static domain:ProcessPriority.Normal}" />
                        <MenuItem Header="Below normal" Command="{Binding SetPriorityCommand}" CommandParameter="{x:Static domain:ProcessPriority.BelowNormal}" />
                        <MenuItem Header="Low" Command="{Binding SetPriorityCommand}" CommandParameter="{x:Static domain:ProcessPriority.Idle}" />
                    </MenuItem>
                    <MenuItem Header="Set affinity…" Command="{Binding SetAffinityCommand}" />
                    <Separator />
                    <MenuItem Header="Open file location" Command="{Binding OpenFileLocationCommand}" />
                    <MenuItem Header="Copy PID" Command="{Binding CopyPidCommand}" />
                    <MenuItem Header="Copy path" Command="{Binding CopyPathCommand}" />
                    <Separator Visibility="{Binding Processes.IsTreeView, Converter={StaticResource BoolToVisibility}}" />
                    <MenuItem Header="Expand all"
                              Command="{Binding Processes.ExpandAllCommand}"
                              Visibility="{Binding Processes.IsTreeView, Converter={StaticResource BoolToVisibility}}" />
                    <MenuItem Header="Collapse all"
                              Command="{Binding Processes.CollapseAllCommand}"
                              Visibility="{Binding Processes.IsTreeView, Converter={StaticResource BoolToVisibility}}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Name" Width="260" SortMemberPath="Name">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:ProcessRowViewModel">
                            <StackPanel Orientation="Horizontal" Margin="{Binding Depth, Converter={StaticResource DepthIndent}}">
                                <Button Style="{StaticResource TreeExpander}"
                                        Command="{Binding DataContext.Processes.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                                <Image Width="16" Height="16" Margin="0,0,8,0" Source="{Binding Icon}" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="PID" Width="90" Binding="{Binding Pid}" ElementStyle="{StaticResource RightAligned}" />
                <DataGridTextColumn Header="Description" Width="240" Binding="{Binding Description}" />
                <DataGridTextColumn Header="CPU %" Width="95" Binding="{Binding CpuPercent, StringFormat=0.0}" ElementStyle="{StaticResource RightAligned}" />
                <DataGridTextColumn Header="Memory" Width="110" Binding="{Binding MemoryBytes, Converter={StaticResource ByteSize}}" SortMemberPath="MemoryBytes" ElementStyle="{StaticResource RightAligned}" />
                <DataGridTextColumn Header="Commit" Width="110" Binding="{Binding CommitBytes, Converter={StaticResource ByteSize}}" SortMemberPath="CommitBytes" ElementStyle="{StaticResource RightAligned}" />
                <DataGridTextColumn Header="Threads" Width="100" Binding="{Binding ThreadCount}" ElementStyle="{StaticResource RightAligned}" />
                <DataGridTextColumn Header="Handles" Width="100" Binding="{Binding HandleCount}" ElementStyle="{StaticResource RightAligned}" />
                <DataGridTextColumn Header="Priority" Width="125" Binding="{Binding Priority}" />
                <DataGridTextColumn Header="User" Width="120" Binding="{Binding UserName}" />
                <DataGridTextColumn Header="Session" Width="95" Binding="{Binding SessionId}" ElementStyle="{StaticResource RightAligned}" />
                <DataGridTextColumn Header="Path" Width="*" MinWidth="200" Binding="{Binding ImagePath}" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Details panel -->
        <GridSplitter Grid.Row="3"
                      Height="6"
                      Margin="12,2,12,0"
                      HorizontalAlignment="Stretch"
                      ResizeDirection="Rows"
                      Background="Transparent"
                      Visibility="{Binding IsDetailsVisible, Converter={StaticResource BoolToVisibility}}" />
        <views:ProcessDetailsView Grid.Row="4"
                                  Margin="12,0,12,0"
                                  DataContext="{Binding Details}"
                                  Visibility="{Binding DataContext.IsDetailsVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />

        <!-- Status bar -->
        <StackPanel Grid.Row="5" Margin="16,6" Orientation="Horizontal">
            <TextBlock Text="{Binding Processes.ProcessCount, StringFormat=Processes: {0}}" />
            <TextBlock Margin="24,0,0,0" Text="{Binding Processes.TotalCpuPercent, StringFormat=CPU: {0:0}%}" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
